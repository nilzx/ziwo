{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ziwo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "MEMORY", "class_name": "Memory" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Memory"] }]
}
