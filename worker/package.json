{
  "name": "ziwo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --config wrangler.dev.jsonc",
    "test": "vitest run && npm run test:node",
    "test:worker": "vitest run",
    "test:node": "node --test 'test/node/*.node.mjs'",
    "smoke": "python3 scripts/smoke.py",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.7.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.33.0",
    "zod": "^4.6.7"
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_SECRET": {
        "description": "The password of your admin page, where you create memories and connect clients. Make up a long one (**at least 16 characters**) and keep it somewhere safe: it cannot be shown again."
      },
      "OAUTH_KV": {
        "description": "Keeps which clients you have approved. Created for you."
      },
      "AI": {
        "description": "Workers AI, used to search memories by meaning. Nothing to set up."
      }
    }
  }
}
